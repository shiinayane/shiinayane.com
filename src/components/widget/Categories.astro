---
import { DEFAULT_LOCALE, type Locale } from "../../i18n/config";
import I18nKey from "../../i18n/i18nKey";
import { translate } from "../../i18n/translation";
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

interface Props {
	class?: string;
	style?: string;
	locale?: Locale;
}
const className = Astro.props.class;
const style = Astro.props.style;
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const categories = await getCategoryList(locale);
const isCollapsed = categories.length >= COLLAPSE_THRESHOLD;
---

<WidgetLayout name={translate(locale, I18nKey.categories)} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style} locale={locale}
>
    {categories.map((c) =>
        <ButtonLink
            url={c.url}
            badge={String(c.count)}
            label={`View all posts in the ${c.name.trim()} category`}
        >
            {c.name.trim()}
        </ButtonLink>
    )}
</WidgetLayout>
