{
	"name": "shiinayane-com",
	"compatibility_date": "2026-05-03", // Update to the day you deploy
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/about*",
			"/archive*",
			"/contact*",
			"/posts/*",
			"/series*",
			"/set-language"
		]
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
